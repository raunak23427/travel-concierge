NEXT_PUBLIC_API_URL=REPLACE_ME

# Optional authenticated same-origin SSE endpoint; leave unset for local reminders.
# This endpoint must be supplied by your notification backend.
# NEXT_PUBLIC_NOTIFICATION_STREAM_URL=/api/notifications/stream

# NextAuth — required
AUTH_SECRET=REPLACE_ME
AUTH_URL=REPLACE_ME

# Google OAuth — get from https://console.cloud.google.com → APIs & Services → Credentials
# IMPORTANT: In Google Cloud Console, add http://localhost:3000/api/auth/callback/google as an Authorized Redirect URI
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# ─── TomTom Routing API ──────────────────────────────────────────────────────
# Get a key from https://developer.tomtom.com/
# Used by the server-side routing proxy at /api/routing.
TOMTOM_API_KEY=REPLACE_ME

# ─── Groq ────────────────────────────────────────────────────────────────────
# Powers the in-app assistant and the Telegram guide. https://console.groq.com
GROQ_API_KEY=REPLACE_ME
# GROQ_MODEL=openai/gpt-oss-120b

# ─── Telegram trip guide ─────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram, /newbot, copy the token here.
# 2. Put the bot's @username (no @) in NEXT_PUBLIC_TELEGRAM_BOT.
# 3. Invent a long random TELEGRAM_WEBHOOK_SECRET — Telegram sends it back on
#    every update, and it is the only thing stopping anyone posting fake ones.
# 4. POST /api/telegram/setup with header `x-cron-secret: $CRON_SECRET`.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME
NEXT_PUBLIC_TELEGRAM_BOT=REPLACE_ME

# Public origin of this deployment — used to build the webhook and invite URLs.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Storage (Upstash Redis, free tier) ──────────────────────────────────────
# The only server-side state in the app: trip snapshots, invite tokens and
# which Telegram chats follow which trip. Without these the bot still runs but
# forgets everything on a cold start.
# Create at https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=REPLACE_ME
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Shared secret between the GitHub Actions cron and /api/cron/notify.
CRON_SECRET=REPLACE_ME

# ─── Hugging Face ────────────────────────────────────────────────────────────
# Powers photo-to-preferences. A small vision-language model is used because
# zero-shot image classification has no live inference provider.
HF_TOKEN=REPLACE_ME
# HF_IMAGE_MODEL=google/gemma-3-4b-it

# ─── Support contact (shown by the support bot) ──────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@wayzyy.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
