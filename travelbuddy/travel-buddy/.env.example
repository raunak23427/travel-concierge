# TravelBuddy — copy to .env.local and fill in what you need.
#
# The app runs with NONE of these set: it falls back to a local Goa knowledge
# base and hides the features it cannot reach. Add keys to switch those on.

# ── Assistant (in-app chat + Telegram Q&A) ───────────────────────────────
# console.groq.com/keys — free tier is plenty for a demo.
GROQ_API_KEY=
# Optional override. Default: openai/gpt-oss-120b
GROQ_MODEL=

# ── Photo → preferences ──────────────────────────────────────────────────
# huggingface.co/settings/tokens — a read token is enough.
HF_TOKEN=
# Optional override. Default: google/gemma-3-4b-it
HF_IMAGE_MODEL=

# ── Telegram bot ─────────────────────────────────────────────────────────
# From @BotFather. Without it, every Telegram surface stays hidden.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram echoes it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Your bot's username, no @. Used to build the deep link in the UI.
NEXT_PUBLIC_TELEGRAM_BOT=

# ── Bot state ────────────────────────────────────────────────────────────
# console.upstash.com — REST credentials, not the Redis URL.
# Without these the store falls back to an in-process Map, and trip links
# die whenever traffic lands on a different lambda.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Notification sweep ───────────────────────────────────────────────────
# Shared secret between the GitHub Actions cron and /api/cron/notify.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The stable public origin. NOT VERCEL_URL — that changes per deployment
# and breaks the OAuth callback.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# console.cloud.google.com — OAuth 2.0 Client ID, type "Web application".
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Maps and routing ─────────────────────────────────────────────────────
# developer.tomtom.com — optional, falls back to OSRM.
TOMTOM_API_KEY=

# ── Public config ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave unset. The Node/Express agent in travelbuddy/server/ is not deployed;
# setting this points the app at a backend that probably is not running.
NEXT_PUBLIC_API_URL=

# ── Support contact shown in the help bot ────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=
